# Modo DEBUG: True para desarrollo, False para producción
DEBUG=True

# Hosts permitidos para Django.
# Para desarrollo con Docker y Nginx, '*' puede ser aceptable.
# En producción, especifica tus dominios: 'dominio.com,www.dominio.com'
ALLOWED_HOSTS='*'
CORS_ALLOWED_ORIGINS='http://localhost:8085'

# --- PostgreSQL settings ---
POSTGRES_DB=events_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_ENGINE=django.db.backends.postgresql

# --- JWT settings ---
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=1
SLIDING_TOKEN_REFRESH_LIFETIME_DAYS=1
SLIDING_TOKEN_LIFETIME_DAYS=7
ROTATE_REFRESH_TOKENS=True
BLACKLIST_AFTER_ROTATION=True
