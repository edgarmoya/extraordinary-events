REACT_APP_BACKEND_URL=http://localhost:8000

# Configuración de Django Backend
# ============================================================

# ¡IMPORTANTE! Cambia esta clave secreta en producción.
# Puedes generar una nueva con:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY='django-insecure-i%&+uyiq6kq36*xj&*@yi9eyto3u8#o45i=8t8=dxv!-)+48eg_CAMBIAR_ESTO_EN_PRODUCCION'

# Modo DEBUG: True para desarrollo, False para producción
DEBUG=True

# Hosts permitidos para Django.
# Para desarrollo con Docker y Nginx, '*' puede ser aceptable.
# En producción, especifica tus dominios: 'dominio.com,www.dominio.com'
ALLOWED_HOSTS='*'
# ALLOWED_HOSTS='localhost,127.0.0.1,backend' # Otra opción para desarrollo

# ============================================================
# Configuración de la Base de Datos PostgreSQL
# Estas variables serán usadas por el servicio 'db' y 'backend' en docker-compose.yml
# ============================================================

POSTGRES_DB=events_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# El DB_HOST para la aplicación Django cuando se ejecuta dentro de Docker Compose
# será el nombre del servicio de la base de datos (definido en docker-compose.yml).
# Esta variable es para que Django la lea desde settings.py.
DB_HOST=db
DB_PORT=5432
DB_ENGINE=django.db.backends.postgresql

# ============================================================
# Configuración de Nginx (Opcional, si Nginx necesitara variables de entorno)
# En este caso, la configuración principal de Nginx está en nginx/default.conf
# ============================================================

# NGINX_HOST=localhost
# NGINX_PORT=3000

# ============================================================
# Configuración de React Frontend (Opcional, si tu build de React usa .env)
# Estas variables deben tener el prefijo REACT_APP_ para ser accedidas en React.
# Ejemplo: REACT_APP_API_URL=http://localhost:3000/api
# ============================================================
# REACT_APP_API_BASE_URL=/api # Se usará un proxy, por lo que la URL base para React es relativa.
